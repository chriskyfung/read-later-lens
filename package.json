{
  "name": "read-later-lens",
  "version": "0.2.0",
  "description": "Client-side bookmark aggregator, search tool, and text-analytics lens for read-later exports — Instapaper today, more sources tomorrow.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ tests/ --no-error-on-unmatched-pattern",
    "lint:fix": "eslint --fix src/ tests/ --no-error-on-unmatched-pattern",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "read-later",
    "bookmark",
    "instapaper",
    "client-side",
    "privacy",
    "offline"
  ],
  "license": "GNU AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chriskyfung/read-later-lens.git"
  },
  "bugs": {
    "url": "https://github.com/chriskyfung/read-later-lens/issues"
  },
  "homepage": "https://github.com/chriskyfung/read-later-lens",
  "author": "chriskyfung",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "idb": "^8.0.3",
    "papaparse": "^5.4.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
